{
  "name": "core-service",
  "version": "0.0.1",
  "description": "Business core of the telemetry platform: tenants, users, fleet, billing and verticals",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "prisma generate && nest build",
    "postinstall": "test -f prisma/schema.prisma && prisma generate || exit 0",
    "db:generate": "prisma generate",
    "db:migrate:new": "prisma migrate dev --create-only --name",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "pnpm build && vitest run --config ./vitest.config.e2e.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "check": "scripts/sync-agent-commands.sh --check && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "sdd:sync": "scripts/sync-agent-commands.sh",
    "docker:build": "docker build -t core-service:local .",
    "test:image": "vitest run --config ./vitest.config.image.ts",
    "test:infra:up": "docker run -d --rm --name core-service-test-mysql -e MYSQL_ROOT_PASSWORD=test -e MYSQL_DATABASE=core_test -p 3307:3306 mysql:8.4",
    "test:infra:down": "docker stop core-service-test-mysql"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/adapter-mariadb": "~7.10.1",
    "@prisma/client": "~7.10.1",
    "jose": "^6.2.12",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "~7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@readme/openapi-parser": "^9.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2",
    "yaml": "^2.9.1"
  }
}
