{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "typescript/no-explicit-any": "off",
    "typescript/no-floating-promises": "error"
  },
  "env": {
    "node": true
  },
  "overrides": [
    {
      "files": ["src/**/domain/**/*.ts"],
      "rules": {
        "typescript/no-explicit-any": "error",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@nestjs/*", "@prisma/*", "**/application/**", "**/infrastructure/**"],
                "message": "domain must not depend on frameworks, Prisma, application or infrastructure (docs/standards/architecture.md)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**/application/**/*.ts"],
      "rules": {
        "typescript/no-explicit-any": "error",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@nestjs/*", "@prisma/*", "**/infrastructure/**"],
                "message": "application must not depend on frameworks, Prisma or infrastructure (docs/standards/architecture.md)"
              }
            ]
          }
        ]
      }
    }
  ]
}
